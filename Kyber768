import oqs
from binascii import hexlify

def run_pqc_kem_demo():
    # 1. Initialize the Key Encapsulation Mechanism (KEM)
    # Kyber768 is a lattice-based algorithm equivalent to AES-192 security level.
    kem_name = "Kyber768"
    
    with oqs.KeyEncapsulation(kem_name) as client:
        print(f"--- Post-Quantum KEM Session: {kem_name} ---")

        # 2. Client generates a key pair (Public Key and Private Key)
        # The public key is shared with the server.
        public_key = client.generate_keypair()
        print(f"[Client] Public Key generated (First 16 bytes): {hexlify(public_key[:16]).decode()}")

        # 3. Server-side simulation: Encapsulate a shared secret
        # The server uses the client's public key to create a ciphertext and a shared secret.
        with oqs.KeyEncapsulation(kem_name) as server:
            ciphertext, shared_secret_server = server.encap_secret(public_key)
            print(f"[Server] Ciphertext created and shared secret established.")

        # 4. Client-side simulation: Decapsulate the secret
        # The client uses its private key to recover the shared secret from the ciphertext.
        shared_secret_client = client.decap_secret(ciphertext)
        print(f"[Client] Secret recovered from ciphertext.")

        # 5. Verification (Classical Statistical Check)
        # In a real scenario, these secrets are used as keys for AES encryption.
        if shared_secret_client == shared_secret_server:
            print("\n[Success] Shared secrets match!")
            print(f"Shared Secret (First 16 bytes): {hexlify(shared_secret_client[:16]).decode()}")
        else:
            print("\n[Error] Shared secrets do not match.")

if __name__ == "__main__":
    run_pqc_kem_demo()
